# pyenv
#   For a library or app, you might want to share your .python-version.
#   For an scm-controlled directory, you might want to ignore it.
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if delegates have different python versions passed,
#   Pipfile.lock might be regenerated, causing conflicts and unnecessary commits.
# Pipfile.lock

# poetry
#   Similar to Pipfile.lock, poetry.lock can be gitignored or not, depending on your preferences.
#   Users may choose to ignore it when writing a library, but keep it for applications.
# poetry.lock

# pdm
#   Similar to Pipfile.lock, pdm.lock can be gitignored or not, depending on your preferences.
# pdm.lock
# .pdm-python.path
# .pdm-build/

# pipproject
#   Similar to Pipfile.lock, pipproject.lock can be gitignored or not, depending on your preferences.
# pipproject.lock

# venv
#   Simplified profiling for local virtual environments
.venv
venv/
ENV/
env/

